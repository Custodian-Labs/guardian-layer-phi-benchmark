# Copy this file to `.env` and fill in real keys. `.env` is git-ignored.
# IMPORTANT: never commit .env, never paste a real key into chat/PRs/docs.

# --- Custodian Labs SDK ---
# Per docs: https://custodian-docs.vercel.app/python-sdk/installation
CUSTODIAN_SDK_API_KEY=
CUSTODIAN_BASE_URL=https://api.custodianai.com
# Optional default config; the runner can also enumerate variants programmatically.
CUSTODIAN_COMPLIANCE_MODE=PROPRIETARY    # MASKED | PROPRIETARY
CUSTODIAN_MASKING_TYPE=transform         # redact | transform
CUSTODIAN_DOMAIN=General

# --- OpenAI (GPT-5 / GPT-4.1 etc.) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- DeepSeek (OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# --- Moonshot Kimi (OpenAI-compatible) ---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# --- Alibaba Qwen DashScope (OpenAI-compatible endpoint) ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max-preview

# --- Google Gemma via Vertex / AI Studio (optional, otherwise use HF local) ---
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-31b-it

# --- John Snow Labs (commercial license JSON path) ---
JSL_LICENSE_PATH=
